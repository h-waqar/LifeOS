# Database connection URL (PostgreSQL)
DATABASE_URL=postgresql://lifeos:lifeos_password@localhost:5432/lifeos

# Better Auth secret key (minimum 32 characters)
BETTER_AUTH_SECRET=changeme_at_least_32_characters_long_random_secret_token

# Better Auth base URL
BETTER_AUTH_URL=http://localhost:3000

# Encryption key at rest for credentials and secrets (strictly 64 hex characters = 32 bytes)
LIFEOS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Node runtime environment
NODE_ENV=development

# Phase 6: AI Layer & Assistant (Optional system fallback keys)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# Phase 7: Automations & Background Scheduler
CRON_SECRET=changeme_cron_secret_token_min_32_characters


